						"description": "Returns { categories: [{ _id, name, owner, createdAt }] } sorted by createdAt. Optional ?owner=<invitation name> filters to that invitation's categories. No permission needed."
					}
				},
				{
					"name": "Add category (to an invitation)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"BSN\",\n  \"owner\": \"Eiman\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/guest-categories",
							"host": ["{{baseUrl}}"],
							"path": ["api", "guest-categories"]
						},
						"description": "Requires edit_guests. `owner` is REQUIRED and must match an existing inviter — the category is then only offered for guests of that invitation. Names are unique per-owner (\"Eiman → BSN\" and \"Abah → BSN\" can coexist). Returns 201 { category } or 409 on duplicates."
					}
				},
				{
					"name": "Rename category (cascades to guests)",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Bank Rakyat\",\n  \"owner\": \"Eiman\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/guest-categories/:id",
							"host": ["{{baseUrl}}"],
							"path": ["api", "guest-categories", ":id"],
							"variable": [
								{
									"key": "id",
									"value": "{{categoryId}}"
								}
							]
						},
						"description": "Requires edit_guests. Renames the category AND updates every guest using it. `owner` is optional here — sending it moves the category to a different invitation (guests under the old invitation keep the category name). Returns { ok: true, renamed: <count> }."
					}
				},
				{
					"name": "Delete category (unassigns guests)",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/guest-categories/:id",
							"host": ["{{baseUrl}}"],
							"path": ["api", "guest-categories", ":id"],
							"variable": [
								{
									"key": "id",
									"value": "{{categoryId}}"
								}
							]
						},
						"description": "Requires edit_guests. Deletes the category and sets category to \"\" on every guest that referenced it (guests are NOT deleted). Returns { ok: true }."
					}
				}
			]
		},
