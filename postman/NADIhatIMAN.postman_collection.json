					}
				},
				{
					"name": "Rename inviter (cascades to guests)",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Ayah's invitation\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/guest-inviters/:id",
							"host": ["{{baseUrl}}"],
							"path": ["api", "guest-inviters", ":id"],
							"variable": [
								{
									"key": "id",
									"value": "{{inviterId}}"
								}
							]
						},
						"description": "Requires edit_guests. Renames the inviter AND updates every guest whose invitedBy matched the old name. Returns { ok: true, renamed: <count> }."
					}
				},
				{
					"name": "Delete inviter (unassigns guests, removes categories)",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/guest-inviters/:id",
							"host": ["{{baseUrl}}"],
							"path": ["api", "guest-inviters", ":id"],
							"variable": [
								{
									"key": "id",
									"value": "{{inviterId}}"
								}
							]
						},
						"description": "Requires edit_guests. Deletes the inviter, sets invitedBy AND category to \"\" on its guests, and deletes the categories owned by it. Guests are NOT deleted. Returns { ok: true }."
					}
				}
