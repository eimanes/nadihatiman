								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Abah's invitation\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/guest-inviters",
							"host": ["{{baseUrl}}"],
							"path": ["api", "guest-inviters"]
						},
